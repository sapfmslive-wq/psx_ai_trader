# PSX AI Trader — environment configuration template
#
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# `python -m src.main init` will copy this automatically if `.env` is missing.

# ---------------------------------------------------------------------------
# TRADING MODE SAFETY SWITCH
# ---------------------------------------------------------------------------
# This is the single master switch for real-money order placement.
# It must stay "false" until:
#   - the system has completed backtesting (Phase 16/17)
#   - the system has completed a sustained paper-trading track record (Phase 20)
#   - a documented, official broker API integration exists (Phase 26)
#   - every check in the live-trading safety checklist passes
# The application will refuse to place a live order while this is false,
# and this switch is never read/overridden anywhere except the eventual
# live order-placement path itself.
LIVE_TRADING_ENABLED=false

# ---------------------------------------------------------------------------
# BROKER CREDENTIALS (Phase 26 — not used yet)
# ---------------------------------------------------------------------------
# BROKER_API_KEY=
# BROKER_API_SECRET=
# BROKER_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# DATA PROVIDER CREDENTIALS (Phase 7)
# ---------------------------------------------------------------------------
# PSXProvider (src/data/psx_provider.py) requires a LICENSED PSX data source.
# It will NOT scrape PSX's public Data Portal (dps.psx.com.pk) — that site's
# own terms prohibit automated dissemination of its data without a license.
#
# To use real PSX data, either:
#   1) License data directly from PSX's Data Services Vending team:
#      marketdatarequest@psx.com.pk
#      https://www.psx.com.pk/psx/product-and-services/data-services-vending
#   2) Subscribe to a PSX-authorized third-party data vendor that exposes
#      an HTTP API
# then fill in the three variables below. Until they're set, PSXProvider
# refuses to connect and explains why — use the mock provider or the CSV
# importer for research and testing instead.
#
# PSX_DATA_API_BASE_URL=
# PSX_DATA_API_KEY=
# PSX_DATA_API_SECRET=

# ---------------------------------------------------------------------------
# ALERTS (Phase 22 — not used yet, optional)
# ---------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ALERT_EMAIL_SMTP_HOST=
# ALERT_EMAIL_SMTP_USER=
# ALERT_EMAIL_SMTP_PASSWORD=
